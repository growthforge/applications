 {
  "id": "TC-07",
  "title": "The PO number and the right person",
  "requirements": [
   "REQ-07"
  ],
  "steps": [
   "Draft an invoice for a housing association job with PO HA-7781.",
   "Check the Reference and who it is addressed to.",
   "Draft one for a housing association that needs a PO, on a job with none."
  ],
  "expected": "The Reference starts with the PO number and ends with the invoice's own code in brackets, for example PO HA-7781 (OPP-2210:FINAL). The invoice goes to the billing contact, the managing agent. The invoice with no PO is held and finance is asked for it.",
  "fn": "buildInvoice",
  "cases": [
   {
    "name": "PO and billing contact",
    "input": {
     "opp": {
      "number": "OPP-2210",
      "stage": "Closed Won",
      "billingType": "Repairs",
      "vat": "Standard",
      "lines": [
       {
        "description": "Boiler repair",
        "qty": 1,
        "unit": 1800,
        "family": "Repairs"
       }
      ],
      "po": "HA-7781"
     },
     "account": {
      "name": "Brightwater Estates",
      "xeroContactId": "xc-100",
      "region": "North",
      "termsDays": 30,
      "billingContactId": "xc-agent"
     },
     "today": "2027-02-01"
    },
    "expect": {
     "payload.Reference": "PO HA-7781 (OPP-2210:FINAL)",
     "payload.Contact.ContactID": "xc-agent"
    }
   },
   {
    "name": "no PO, no billing contact",
    "input": {
     "opp": {
      "number": "OPP-2210",
      "stage": "Closed Won",
      "billingType": "Repairs",
      "vat": "Standard",
      "lines": [
       {
        "description": "Boiler repair",
        "qty": 1,
        "unit": 1800,
        "family": "Repairs"
       }
      ]
     },
     "account": {
      "name": "Brightwater Estates",
      "xeroContactId": "xc-100",
      "region": "North",
      "termsDays": 30
     },
     "today": "2027-02-01"
    },
    "expect": {
     "payload.Reference": "OPP-2210:FINAL",
     "payload.Contact.ContactID": "xc-100"
    }
   },
   {
    "name": "a PO is needed and missing",
    "input": {
     "opp": {
      "number": "OPP-2210",
      "stage": "Closed Won",
      "billingType": "Repairs",
      "vat": "Standard",
      "lines": [
       {
        "description": "Boiler repair",
        "qty": 1,
        "unit": 1800,
        "family": "Repairs"
       }
      ]
     },
     "account": {
      "name": "Brightwater Estates",
      "xeroContactId": "xc-100",
      "region": "North",
      "termsDays": 30,
      "poRequired": true
     },
     "today": "2027-02-01"
    },
    "expect": {
     "ok": false,
     "reason": "po-required"
    }
   },
   {
    "name": "a PO is needed and given",
    "input": {
     "opp": {
      "number": "OPP-2210",
      "stage": "Closed Won",
      "billingType": "Repairs",
      "vat": "Standard",
      "lines": [
       {
        "description": "Boiler repair",
        "qty": 1,
        "unit": 1800,
        "family": "Repairs"
       }
      ],
      "po": "HA-7781"
     },
     "account": {
      "name": "Brightwater Estates",
      "xeroContactId": "xc-100",
      "region": "North",
      "termsDays": 30,
      "poRequired": true
     },
     "today": "2027-02-01"
    },
    "expect": {
     "ok": true
    }
   },
   {
    "name": "a monthly invoice carries its month",
    "input": {
     "opp": {
      "number": "OPP-2210",
      "stage": "Closed Won",
      "billingType": "Repairs",
      "vat": "Standard",
      "lines": [
       {
        "description": "Boiler repair",
        "qty": 1,
        "unit": 1800,
        "family": "Repairs"
       }
      ],
      "po": "HA-7781"
     },
     "account": {
      "name": "Brightwater Estates",
      "xeroContactId": "xc-100",
      "region": "North",
      "termsDays": 30
     },
     "today": "2027-02-01",
     "line": "2027-03"
    },
    "expect": {
     "payload.Reference": "PO HA-7781 (OPP-2210:2027-03)",
     "key": "OPP-2210:2027-03"
