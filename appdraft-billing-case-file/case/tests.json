[
 {
  "id": "TC-01",
  "title": "A repair is invoiced when the job is done",
  "requirements": [
   "REQ-01"
  ],
  "steps": [
   "In Salesforce, open a won repair job that has not been completed. Check Xero: there should be no invoice for it.",
   "Mark the job complete and enter the final amount. Check Xero a little later: there is one draft invoice for the final amount."
  ],
  "expected": "No invoice before completion. One draft after, for the final amount, not the quote.",
  "fn": "shouldInvoice",
  "cases": [
   {
    "name": "won, not completed",
    "input": {
     "stage": "Closed Won",
     "billingType": "Repairs",
     "quote": 1800
    },
    "expect": {
     "create": false,
     "reason": "job-not-completed"
    }
   },
   {
    "name": "completed, final amount differs from the quote",
    "input": {
     "stage": "Closed Won",
     "billingType": "Repairs",
     "quote": 1800,
     "finalAmount": 2150,
     "jobCompletedDate": "2027-02-02"
    },
    "expect": {
     "create": true,
     "amount": 2150
    }
   },
   {
    "name": "a planned maintenance contract uses its schedule",
    "input": {
     "stage": "Closed Won",
     "billingType": "Planned maintenance"
    },
    "expect": {
     "create": false,
     "reason": "use-schedule"
    }
   },
   {
    "name": "an open deal does nothing",
    "input": {
     "stage": "Negotiation",
     "billingType": "Repairs"
    },
    "expect": {
     "create": false,
     "reason": "not-won"
    }
   }
  ],
  "runBy": "client"
 },
 {
  "id": "TC-02",
  "title": "The deposit and the balance add up to the penny",
  "requirements": [
   "REQ-02"
  ],
  "steps": [
   "Win a repair worth 1,001.01 with a 50 percent deposit and complete it at 1,200. Compare the deposit and balance invoices in Xero with the final amount.",
   "Win a repair worth 1,000 with a 50 percent deposit and complete it at 400."
  ],
  "expected": "Deposit 500.51 on the quote and balance 699.49 on completion, which add up to the final amount of 1,200. When the job comes in below the deposit, finance is told a credit is due.",
  "fn": "splitDeposit",
  "cases": [
   {
    "name": "an odd penny",
    "input": {
     "total": 1001.01,
     "percent": 50
    },
    "expect": {
     "deposit": 500.51,
     "balance": 500.5,
     "total": 1001.01
    }
   },
   {
    "name": "the final amount is higher than the quote",
    "input": {
     "total": 1001.01,
     "percent": 50,
     "final": 1200
    },
    "expect": {
     "deposit": 500.51,
     "balance": 699.49,
     "total": 1200
    }
   },
   {
    "name": "the final amount is lower than the deposit",
    "input": {
     "total": 1000,
     "percent": 50,
     "final": 400
    },
    "expect": {
     "deposit": 500,
     "balance": -100,
     "total": 400,
     "creditNeeded": true
    }
   },
   {
    "name": "a third, roughly",
    "input": {
     "total": 999.99,
     "percent": 33.3
    },
    "expect": {
     "deposit": 333,
     "balance": 666.99
    }
   },
   {
    "name": "all of it up front",
    "input": {
     "total": 1200,
     "percent": 100
    },
    "expect": {
     "deposit": 1200,
     "balance": 0
    }
   }
  ],
  "runBy": "client"
 },
 {
  "id": "TC-03",
  "title": "The monthly schedule and the April price rise",
  "requirements": [
   "REQ-03"
  ],
  "steps": [
   "Win a 12 month contract starting 31 January at 500 a month with a 3.4 percent rise from April.",
   "Look at the schedule in Salesforce: dates, then amounts."
  ],
  "expected": "Each month on the same day (or the last day of a short month), 500 until March and 517 from April. Each month is its own line, so each becomes its own invoice.",
  "fn": "scheduleAmounts",
  "cases": [
   {
    "name": "dates in short months and the first rise",
    "input": {
     "start": "2027-01-31",
     "months": 4,
     "monthly": 500,
     "upliftMonth": 4,
     "upliftPercent": 3.4
    },
    "expect": {
     "length": 4,
     "[1].date": "2027-02-28",
     "[1].line": "2027-02",
     "[3].date": "2027-04-30",
     "[0].amount": 500,
     "[3].amount": 517
    }
   },
   {
    "name": "leap year",
    "input": {
     "start": "2028-01-31",
     "months": 2,
     "monthly": 500,
     "upliftMonth": 4,
     "upliftPercent": 3.4
    },
    "expect": {
     "[1].date": "2028-02-29"
    }
   },
   {
    "name": "the rise rounds to the penny",
    "input": {
     "start": "2028-03-15",
     "months": 2,
     "monthly": 333.33,
     "upliftMonth": 4,
     "upliftPercent": 3.4
    },
    "expect": {
     "[0].amount": 333.33,
     "[1].amount": 344.66
    }
   },
   {
    "name": "a start after April waits for next April",
    "input": {
     "start": "2027-05-15",
     "months": 12,
     "monthly": 500,
     "upliftMonth": 4,
     "upliftPercent": 3.4
    },
    "expect": {
     "[10].amount": 500,
     "[11].amount": 517
    }
   }
  ],
  "runBy": "client"
 },
