{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Complaints mailbox triage",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "possible_emergency", "confidence", "reason", "customer_name", "development", "plot", "reservation_date", "completion_date", "issues", "previous_reference", "draft_reply"],
  "properties": {
    "type": { "enum": ["formal_complaint", "aftercare_item", "general_enquiry"] },
    "possible_emergency": { "type": "boolean" },
    "confidence": { "enum": ["high", "medium", "low"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 400 },
    "customer_name": { "type": ["string", "null"] },
    "development": { "type": ["string", "null"] },
    "plot": { "type": ["string", "null"] },
    "reservation_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "completion_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "issues": { "type": "array", "items": { "type": "string" }, "maxItems": 10 },
    "previous_reference": { "type": ["string", "null"] },
    "draft_reply": { "type": "string", "minLength": 1, "maxLength": 1200 }
  }
}
